lative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-n1" value="&lt;b&gt;«extend» Crear una cuenta&lt;/b&gt;&lt;br&gt;Condición: la persona no tiene&lt;br&gt;cuenta y elige &quot;Crear cuenta&quot;.&lt;br&gt;Punto: sin cuenta (paso 4 de CU-02)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="745" y="295" width="245" height="66" as="geometry"/></mxCell><mxCell id="p2-n1-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p2-n1"><mxGeometry relative="1" as="geometry"><mxPoint x="679" y="336" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p2-n2" value="&lt;b&gt;Iniciar y cerrar sesión&lt;/b&gt;&lt;br&gt;Los usan los tres actores; cada uno entra&lt;br&gt;solo a las funciones de su rol (RNF-SEG-003)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="550" y="825" width="330" height="52" as="geometry"/></mxCell><mxCell id="p2-n2-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p2-n2" target="p2-CU03"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Registro diario y dispositivos" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1210" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-sis" value="NutriGo! · Registro diario y dispositivos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="30" width="900" height="790" as="geometry"/></mxCell><mxCell id="p3-PAC" value="Paciente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="72" y="390" width="36" height="80" as="geometry"/></mxCell><mxCell id="p3-CU05" value="Vincular un dispositivo&lt;br&gt;&lt;b&gt;CU-05&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-011&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="107" width="272" height="66" as="geometry"/></mxCell><mxCell id="p3-CU06" value="Desvincular un dispositivo&lt;br&gt;&lt;b&gt;CU-06&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-013&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="257" width="272" height="66" as="geometry"/></mxCell><mxCell id="p3-CU07" value="Registrar el seguimiento diario&lt;br&gt;&lt;b&gt;CU-07&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-007 · 008 · 009 · 012 · 031 · 032&lt;/font&gt;&lt;hr&gt;&lt;i&gt;puntos de extensión:&lt;/i&gt;&lt;br&gt;dato incorrecto (paso 3)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="439" width="272" height="102" as="geometry"/></mxCell><mxCell id="p3-CU08" value="Corregir un registro&lt;br&gt;&lt;b&gt;CU-08&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-010 · RF-027&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="677" width="272" height="66" as="geometry"/></mxCell><mxCell id="p3-e0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p3-PAC" target="p3-CU05"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p3-PAC" target="p3-CU06"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p3-PAC" target="p3-CU07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p3-PAC" target="p3-CU08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-e4" value="«extend»" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p3-CU08" target="p3-CU07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3-n1" value="&lt;b&gt;«extend» Corregir un registro&lt;/b&gt;&lt;br&gt;Condición: un dato que llegó del&lt;br&gt;dispositivo es incorrecto (flujo 3a).&lt;br&gt;Punto: dato incorrecto (paso 3 de CU-07)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="810" y="680" width="330" height="66" as="geometry"/></mxCell><mxCell id="p3-n1-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p3-n1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="609" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p3-n2" value="&lt;b&gt;Flujos alternos de CU-07&lt;/b&gt;&lt;br&gt;Días sin registro (RF-009, RF-032)&lt;br&gt;Dato sin llegar del dispositivo (RF-008)&lt;br&gt;Valor fuera de rango (RNF-CON-002)&lt;br&gt;Guardar lo que llevo (RF-031)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="830" y="530" width="320" height="80" as="geometry"/></mxCell><mxCell id="p3-n2-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p3-n2" target="p3-CU07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-n3" value="&lt;b&gt;Dispositivos compatibles&lt;/b&gt;&lt;br&gt;Reloj, banda de actividad o báscula.&lt;br&gt;Sus datos llegan solos al registro&lt;br&gt;del día (RF-012)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="850" y="65" width="320" height="66" as="geometry"/></mxCell><mxCell id="p3-n3-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p3-n3" target="p3-CU05"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Progreso, informes y plan" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-sis" value="NutriGo! · Progreso, informes y plan alimenticio" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="30" width="910" height="790" as="geometry"/></mxCell><mxCell id="p4-PAC" value="Paciente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="72" y="390" width="36" height="80" as="geometry"/></mxCell><mxCell id="p4-CU09" value="Consultar el progreso físico&lt;br&gt;&lt;b&gt;CU-09&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-014 · RF-027&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="107" width="272" height="66" as="geometry"/></mxCell><mxCell id="p4-CU10" value="Descargar un informe&lt;br&gt;&lt;b&gt;CU-10&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-026 · RF-027&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="267" width="272" height="66" as="geometry"/></mxCell><mxCell id="p4-CU12" value="Consultar el plan alimenticio&lt;br&gt;semanal&lt;br&gt;&lt;b&gt;CU-12&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-016 · RF-017 · RF-030&lt;/font&gt;&lt;hr&gt;&lt;i&gt;puntos de extensión:&lt;/i&gt;&lt;br&gt;sin preferencias (paso 1)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="441" width="272" height="118" as="geometry"/></mxCell><mxCell id="p4-CU11" value="Configurar las preferencias&lt;br&gt;alimenticias&lt;br&gt;&lt;b&gt;CU-11&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-015&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="454" y="679" width="272" height="82" as="geometry"/></mxCell><mxCell id="p4-e0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p4-PAC" target="p4-CU09"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p4-PAC" target="p4-CU10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p4-PAC" target="p4-CU11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p4-PAC" target="p4-CU12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-e4" value="«extend»" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;fontSize=11;" edge="1" parent="1" source="p4-CU11" target="p4-CU12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-n1" value="&lt;b&gt;«extend» Configurar las preferencias&lt;/b&gt;&lt;br&gt;Condición: el paciente abre su plan&lt;br&gt;sin preferencias registradas (1a).&lt;br&gt;Punto: sin preferencias (paso 1 de CU-12)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="820" y="630" width="330" height="66" as="geometry"/></mxCell><mxCell id="p4-n1-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p4-n1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p4-n2" value="&lt;b&gt;Ajuste semanal (RF-017)&lt;/b&gt;&lt;br&gt;Cada lunes el plan nuevo usa los días&lt;br&gt;con registro de la semana anterior;&lt;br&gt;los días &quot;Sin registro&quot; no se usan." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="830" y="445" width="320" height="66" as="geometry"/></mxCell><mxCell id="p4-n2-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p4-n2" target="p4-CU12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-n3" value="&lt;b&gt;Registros con más de 30 días&lt;/b&gt;&lt;br&gt;Se sustituyen por un resumen mensual&lt;br&gt;(RF-027): la gráfica anual y el informe&lt;br&gt;de esos meses usan ese resumen." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="830" y="175" width="320" height="66" as="geometry"/></mxCell><mxCell id="p4-n3-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p4-n3" target="p4-CU10"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Citas con el nutriólogo" id="p5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-sis" value="NutriGo! · Citas con el nutriólogo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=16;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="30" width="1040" height="750" as="geometry"/></mxCell><mxCell id="p5-PAC" value="Paciente" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="72" y="340" width="36" height="80" as="geometry"/></mxCell><mxCell id="p5-NUT" value="Nutriólogo" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1472" y="340" width="36" height="80" as="geometry"/></mxCell><mxCell id="p5-CU14" value="Solicitar una cita remota&lt;br&gt;&lt;b&gt;CU-14&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-019 · 020 · 023 · 033&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="414" y="157" width="272" height="66" as="geometry"/></mxCell><mxCell id="p5-CU15" value="Cancelar una cita&lt;br&gt;&lt;b&gt;CU-15&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-021&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="414" y="347" width="272" height="66" as="geometry"/></mxCell><mxCell id="p5-CU17" value="Retirar la autorización a un&lt;br&gt;nutriólogo&lt;br&gt;&lt;b&gt;CU-17&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-024&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="414" y="529" width="272" height="82" as="geometry"/></mxCell><mxCell id="p5-CU13" value="Registrar los horarios de&lt;br&gt;atención&lt;br&gt;&lt;b&gt;CU-13&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-018&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="914" y="149" width="272" height="82" as="geometry"/></mxCell><mxCell id="p5-CU16" value="Atender una solicitud de cita&lt;br&gt;&lt;b&gt;CU-16&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-022 · RF-033&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="914" y="347" width="272" height="66" as="geometry"/></mxCell><mxCell id="p5-CU18" value="Revisar el progreso de un&lt;br&gt;paciente&lt;br&gt;&lt;b&gt;CU-18&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;RF-025&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#EAF2FB;strokeColor=#2E5C8A;" vertex="1" parent="1"><mxGeometry x="914" y="529" width="272" height="82" as="geometry"/></mxCell><mxCell id="p5-e0" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-PAC" target="p5-CU14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-PAC" target="p5-CU15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-PAC" target="p5-CU17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-NUT" target="p5-CU13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e4" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-NUT" target="p5-CU16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-e5" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="p5-NUT" target="p5-CU18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5-n1" value="&lt;b&gt;Autorización (RF-023, RNF-SEG-002)&lt;/b&gt;&lt;br&gt;&quot;Compartir mi progreso&quot; en CU-14 autoriza al&lt;br&gt;nutriólogo; CU-17 la retira y CU-18 la verifica&lt;br&gt;antes de mostrar la información del paciente." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="670" y="680" width="380" height="66" as="geometry"/></mxCell><mxCell id="p5-n1-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p5-n1" target="p5-CU18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-n2" value="&lt;b&gt;Espacios de cita&lt;/b&gt;&lt;br&gt;CU-14 solo ofrece los espacios que el nutriólogo&lt;br&gt;registró en CU-13; CU-15 y el rechazo en CU-16&lt;br&gt;los vuelven a liberar." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;fontSize=11;fillColor=#FFF9DB;strokeColor=#B8A04A;" vertex="1" parent="1"><mxGeometry x="670" y="55" width="380" height="66" as="geometry"/></mxCell><mxCell id="p5-n2-l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8A04A;" edge="1" parent="1" source="p5-n2" target="p5-CU13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>